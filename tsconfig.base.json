{
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    // Type-checks workspace packages against their sources, so no build is necessary first.
    "paths": {
      "@awesome-reveal/astro": ["./packages/astro/src/index.ts"],
      "@awesome-reveal/astro/keyframes": ["./packages/astro/src/keyframes.ts"],
      "@awesome-reveal/core": ["./packages/core/src/index.ts"],
      "@awesome-reveal/core/keyframes": ["./packages/core/src/keyframes/index.ts"],
      "@awesome-reveal/react": ["./packages/react/src/index.ts"],
      "@awesome-reveal/react/keyframes": ["./packages/react/src/keyframes.ts"],
      "@awesome-reveal/test-utils/*": ["./packages/test-utils/src/*.ts"],
      "@awesome-reveal/vue": ["./packages/vue/src/index.ts"],
      "@awesome-reveal/vue/keyframes": ["./packages/vue/src/keyframes.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true
  }
}
