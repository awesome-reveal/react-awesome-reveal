{
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    // Type-checks workspace packages against their sources, so no build is necessary first.
    "paths": {
      "@awesome-reveal/core": ["./packages/core/src/index.ts"],
      "@awesome-reveal/core/keyframes": ["./packages/core/src/keyframes/index.ts"],
      "@awesome-reveal/react": ["./packages/react/src/index.ts"],
      "@awesome-reveal/react/keyframes": ["./packages/react/src/keyframes.ts"],
      "@awesome-reveal/test-utils/*": ["./packages/test-utils/src/*.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true
  }
}
