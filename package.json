{
  "name": "react-awesome-reveal",
  "version": "4.3.1",
  "description": "React components to add reveal animations using the Intersection Observer API and CSS Animations.",
  "keywords": [
    "animations",
    "css-in-js",
    "emotion",
    "intersection",
    "intersection-observer",
    "react",
    "react-reveal",
    "reveal",
    "scroll",
    "typescript"
  ],
  "homepage": "https://react-awesome-reveal.morello.dev",
  "bugs": {
    "url": "https://github.com/awesome-reveal/react-awesome-reveal/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Dennis Morello",
    "email": "dennis@morello.dev",
    "url": "https://morello.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/awesome-reveal/react-awesome-reveal"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/morellodev"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/react-awesome-reveal"
    }
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "vitest run --project unit",
    "test:package": "pnpm build && vitest run --project package && publint --strict && attw --pack . --profile esm-only --ignore-rules internal-resolution-error",
    "test:watch": "vitest --project unit"
  },
  "dependencies": {
    "react-intersection-observer": "^11.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@emotion/react": "catalog:",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "^5.0.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "publint": "^0.3.25",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "^5.7.2",
    "vite": "catalog:",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "react": ">=17.0.0"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
