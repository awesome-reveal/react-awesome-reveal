{
  "name": "awesome-reveal",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "vitest run --project \"*:unit\" --project \"*:ssr\" --project \"*:browser\"",
    "test:package": "pnpm build && vitest run --project \"*:package\" && pnpm --filter \"./packages/*\" check:package",
    "test:watch": "vitest --project \"*:unit\""
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.19.1",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-istanbul": "^5.0.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.64.0",
    "publint": "^0.3.25",
    "typescript": "^5.7.2",
    "vite": "catalog:",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
