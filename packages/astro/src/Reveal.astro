---
import type { HTMLTag } from "astro/types";

import type { RevealProps } from "./index.js";

type Props<Tag extends HTMLTag = "div"> = RevealProps<Tag>;

const {
  as: Tag = "div",
  keyframes,
  duration,
  delay,
  stagger,
  threshold,
  rootMargin,
  once,
  when,
  reducedMotion,
  ...rest
} = Astro.props;

// `transition:persist` on the component must move the host, which holds the reveal state.
const {
  "data-astro-transition-persist": persist,
  "data-astro-transition-persist-props": persistProps,
  ...attributes
} = rest as typeof rest & Record<`data-astro-transition-persist${string}`, string | undefined>;

const options = JSON.stringify({
  keyframes,
  duration,
  delay,
  stagger,
  threshold,
  rootMargin,
  once,
  when,
  reducedMotion,
});
---

<awesome-reveal
  options={options}
  data-astro-transition-persist={persist}
  data-astro-transition-persist-props={persistProps}
>
  <Tag {...attributes} data-reveal={when ? undefined : "hidden"}><slot /></Tag>
</awesome-reveal>

<style is:global>
  awesome-reveal {
    display: contents;
  }

  /* Astro CSP blocks style attributes, so the server markup hides the element with this rule. */
  @media (scripting: enabled) {
    awesome-reveal > [data-reveal="hidden"] {
      opacity: 0 !important;
    }
  }
</style>

<script>
  import { RevealElement } from "./element.js";

  if (!customElements.get("awesome-reveal")) customElements.define("awesome-reveal", RevealElement);
</script>
