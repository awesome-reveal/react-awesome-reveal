{
  "name": "react-awesome-reveal",
  "version": "4.3.1",
  "description": "Reveal-on-scroll animations for React. This package re-exports @awesome-reveal/react.",
  "keywords": [
    "animation",
    "hooks",
    "intersection-observer",
    "react",
    "reveal",
    "scroll",
    "scroll-reveal",
    "typescript",
    "waapi",
    "web-animations"
  ],
  "homepage": "https://awesome-reveal.morello.dev",
  "bugs": {
    "url": "https://github.com/awesome-reveal/awesome-reveal/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Dennis Morello",
    "email": "dennismorello@gmail.com",
    "url": "https://morello.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awesome-reveal/awesome-reveal.git",
    "directory": "packages/react-awesome-reveal"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/morellodev"
    }
  ],
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./keyframes": {
      "types": "./dist/keyframes.d.ts",
      "default": "./dist/keyframes.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@awesome-reveal/react": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
